# =================================================================
# KARMIC AI PLATFORM - CLOUD CONFIGURATION TEMPLATE
# Copy this file to .env.cloud and fill in your generated credentials
# =================================================================

# 1. Supabase (Managed PostgreSQL 16 + pgvector + User Auth)
# Obtain from: https://supabase.com -> Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# 2. Groq Cloud (Free Llama 3.3 70B & 8B Inference)
# Obtain from: https://console.groq.com -> API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 3. Google AI Studio (Free Gemini 2.0 / 1.5 Flash Inference)
# Obtain from: https://aistudio.google.com -> Get API Key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# 4. GitHub Configuration (For Code Repository & Vercel Sync)
GITHUB_REPO=https://github.com/your-username/karmic-ai-platform

# 5. Core Application Security & Host URLs
JWT_SECRET=super-secret-random-32-character-string-change-this
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

